#!/bin/sh
#
# playwright [command...]: the command line of the Playwright installed in
# this image.
#
# `playwright install` takes a lock in the browser directory, and records
# there who asked, before it looks at what is installed. Where that directory
# cannot be written, as under a read-only root file system, it retries the
# lock for about eight minutes and then fails, though the browser it was asked
# for is there. So when the image's browser directory is read-only, the
# command works from a directory under TMPDIR that links to the installed
# browsers: the lock and the record go there, and the browsers are found with
# nothing to download. A browser directory someone else chose is left alone.
set -eu

installed="${PLAYWRIGHT_INSTALLED_BROWSERS:-/opt/playwright/browsers}"
if [ "${PLAYWRIGHT_BROWSERS_PATH:-}" = "${installed}" ] && [ ! -w "${installed}" ]; then
    PLAYWRIGHT_BROWSERS_PATH="${TMPDIR:-/tmp}/playwright-browsers"
    export PLAYWRIGHT_BROWSERS_PATH
    mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}"
    for browser in "${installed}"/*; do
        ln -sfn "${browser}" "${PLAYWRIGHT_BROWSERS_PATH}/${browser##*/}"
    done
fi

exec "${PLAYWRIGHT_CLI:-/opt/playwright/bin/playwright}" "$@"
