#!/usr/bin/env bash
#
# gui-browser [url...]: one maximized Chromium on the sandbox's desktop,
# opened at the given addresses, and opened again when it is closed. It is a
# workload's command, so it runs until the workload stops. Tabs and windows
# an agent or a person opens live in this one browser.
set -euo pipefail

# shellcheck source=gui/session.sh
source "${GUI_SESSION:-/usr/local/bin/gui-session}"

gui_wait_for_display gui-browser
gui_writable_state
gui_supervise browser chromium-launch --start-maximized "$@"
gui_run_supervised
